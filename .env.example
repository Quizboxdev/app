# Every environment variable the code reads. Copy to .env.local and fill in values for a NON-production Supabase project.
# Real values live in Vercel (Production and Preview scopes) and Supabase. Never commit a real value, and never paste one into chat or a screenshot.

# --- Required to run the site -------------------------------------------------------------------------------------------------------------
# Production is fmgccmqxfjppqydkhaiu and Preview is fngdtxayfoiffbcbmcum. For everyday work use Preview or your own project, not Production.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NON-PRODUCTION-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
QB_SUPABASE_MANAGEMENT_TOKEN=

# --- Server only (Vercel, never NEXT_PUBLIC_) ----------------------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=        # full database access for server routes (payments, exports, support). Preview must hold the PREVIEW project's key.
PAYSTACK_SECRET_KEY=              # live key (sk_live_...) in Production only; sk_test_... in Preview. Never the live key outside Production.
RESEND_API_KEY=                   # sends support and notification email
EMAIL_FROM=                       # sender address, for example "QuizBox <hello@quizbox.io>"
CRON_SECRET=                      # bearer secret for the scheduled routes under /api/cron (Vercel sends it)
QB_OPS_SECRET=                    # secret for /api/ops/refresh-analytics
INTAKE_HASH_SALT=                 # salt for hashing visitor ids in the public intake and view counters
VAPID_PRIVATE_KEY=                # web push signing key (pair of NEXT_PUBLIC_VAPID_PUBLIC_KEY)
VAPID_SUBJECT=                    # mailto: address for web push

# --- Public settings ---------------------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.quizbox.io   # used for canonical links and share previews; must equal the address the site is served from
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Switches ----------------------------------------------------------------------------------------------------------------------------------
QB_SERVER_GUARD=                  # "on" sends signed-out visitors away from signed-in pages on the server (docs/release/SERVER_GUARD.md). Off by default.
QB_CSP_MODE=                      # "enforce" makes the Content Security Policy blocking; anything else is report-only (docs/ops/CSP_ENFORCEMENT.md)

# --- Acceptance-only. Never set these in production. Passwords belong in ignored local files. ------------------------------------------------------
QB_ENVIRONMENT=local
QB_ACCEPTANCE_PROJECT_REF=
QB_PRODUCTION_PROJECT_REF=
QB_ACCEPTANCE_PASSWORD=
QB_CONTENT_OPERATOR_EMAIL=
QB_CONTENT_OPERATOR_PASSWORD=
QB_ACCEPTANCE_ADMIN_EMAIL=
QB_ACCEPTANCE_ADMIN_PASSWORD=
QB_ACCEPTANCE_STUDENT_EMAIL=
QB_ACCEPTANCE_STUDENT_PASSWORD=
QB_ACCEPTANCE_STUDENT2_EMAIL=
QB_ACCEPTANCE_STUDENT2_PASSWORD=
QB_ACCEPTANCE_TEACHER_EMAIL=
QB_ACCEPTANCE_TEACHER_PASSWORD=
QB_ACCEPTANCE_SPONSOR_EMAIL=
QB_ACCEPTANCE_SPONSOR_PASSWORD=
QB_ACCEPTANCE_SELLER_EMAIL=
QB_ACCEPTANCE_SELLER_PASSWORD=
